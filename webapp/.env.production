# Production API origin, baked in at build time by `npm run build`.
#
# Without this, api.js falls back to its dev default http://127.0.0.1:3004 and the
# shipped bundle calls the developer's own machine — the app then renders
# "Немає з'єднання" for every real user. That shipped once (2026-07-26); this file
# is the guard so a plain `npm run build` is always deploy-safe.
VITE_API_URL=https://app.football-blitz.online
